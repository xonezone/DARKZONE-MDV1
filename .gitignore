testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Python venv created by package tooling
.pythonlibs/

# WhatsApp auth/session state — runtime secrets (committed by explicit request for backup)


# Runtime captured media (sticker/image capture temp files)
artifacts/api-server/data/captures/

# Secrets - never upload these
.env
.env.*
!.env.example

# WhatsApp login (session) files - NEVER upload these
artifacts/api-server/data/wa-auth/
# Downloaded tools (ffmpeg, yt-dlp)
artifacts/api-server/bin/

# yt-dlp login cookies - NEVER upload these
cookies*.txt

# Termux runtime files
bot.log
bot.log.old
bot.pid
